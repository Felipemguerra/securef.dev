---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('repos')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const combinedTitle = SITE_TITLE + " - Repos"
const combinedDesc = SITE_DESCRIPTION + " - Repos"
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={combinedTitle} description={combinedDesc} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				max-width: 720px;
				margin: 0 auto;
				padding: 0;
			}
			ul li {
				width: 100%;
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 150px;
				height: 75px;
				flex-shrink: 0;
				object-fit: cover;
				border-radius: 12px;
			}
			ul li a {
				display: flex;
				align-items: center;
				gap: 1.5rem;
			}
			.article-info {
				min-width: 0;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			ul li a:hover h4 {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 0.5em;
				}
				ul li img {
					width: 120px;
					height: 60px;
				}
				ul li a {
					gap: 0.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/repos/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<div class="article-info">
										<h4 class="title">{post.data.title}</h4>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
